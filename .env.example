# Copy to .env and fill in real values before running docker compose.
# Never commit the real .env file.

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Token lifetimes in milliseconds. Both are optional — the defaults below are
# what the app uses if you leave them unset. Clients refresh the short-lived
# access token silently against /api/auth/refresh.
# Shortening JWT_EXPIRATION_MS (e.g. 60000) is a handy way to exercise the
# refresh path without waiting.
# JWT_EXPIRATION_MS=900000
# JWT_REFRESH_EXPIRATION_MS=2592000000
